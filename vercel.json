{
  "framework": null,
  "functions": {
    "api/votes.js": {
      "maxDuration": 60
    },
    "api/jobs.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/votes-feed",
      "destination": "/api/votes?route=votes-feed"
    },
    {
      "source": "/api/sync-votes",
      "destination": "/api/votes?route=sync-votes"
    },
    {
      "source": "/api/bill-vote-match",
      "destination": "/api/votes?route=bill-vote-match"
    },
    {
      "source": "/api/watch-bills",
      "destination": "/api/jobs?route=watch-bills"
    },
    {
      "source": "/api/deliver-notifications",
      "destination": "/api/jobs?route=deliver-notifications"
    },
    {
      "source": "/api/cron-sync-bills",
      "destination": "/api/jobs?route=sync-bills"
    },
    {
      "source": "/representatives/:id",
      "destination": "/representatives.html?id=:id"
    }
  ],
  "crons": [
    {
      "path": "/api/watch-bills",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/deliver-notifications",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/jobs?route=sync-bills&limit=40",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/sync-votes?limit=100&chamber=both",
      "schedule": "0 7 * * *"
    }
  ]
}
